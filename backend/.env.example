# ClearPay AI Backend Environment Variables
# To use locally: copy this file to backend/.env and fill in your values
# For production: set these environment variables in your Render Web Service dashboard
# NEVER commit real .env files with credentials

# API & Server Configuration
APP_NAME=ClearPay AI API
DEBUG=False
# PORT is automatically set by Render in production; defaults to 8000 locally
PORT=8000

# Database Configuration
# Local SQLite development (default):
DATABASE_URL=sqlite:///./clearpayai.db
# Production PostgreSQL (Neon, Render PostgreSQL, AWS RDS, Supabase):
# Note: Both postgresql:// and postgres:// formats are automatically supported.
# Example: postgresql://username:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql://user:password@ep-sample.neon.tech/clearpayai?sslmode=require

# Frontend & CORS Configuration
# Set FRONTEND_URL to your deployed Vercel URL (e.g. https://clearpayai.vercel.app)
FRONTEND_URL=http://localhost:5173
# Additional allowed CORS origins (comma-separated, optional)
# All *.vercel.app preview URLs are automatically permitted via origin regex.
# CORS_ORIGINS=https://clearpayai.vercel.app,https://mycustomdomain.com

# PayPal Sandbox Configuration
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Gemini AI Configuration
# Get an API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Optional Demo Mode (1 = enable simulated payments without real PayPal calls)
# DEMO_MODE=0

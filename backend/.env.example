# ClearPay AI Backend Environment Variables
# To use: copy this file to .env and fill in your values
# NEVER commit real .env files with credentials

# API Configuration
APP_NAME=ClearPay AI API
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./clearpayai.db

# Backend Service URLs
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

# PayPal Sandbox Configuration
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Gemini AI Configuration
# Get an API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

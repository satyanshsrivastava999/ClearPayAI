# ClearPay AI Backend Environment Variables
# To use locally: copy this file to backend/.env and fill in your values
# For Vercel deployment: configure these environment variables in your Vercel Project Settings > Environment Variables
# NEVER commit real .env files with credentials

# ==============================================================================
# VERCEL ENVIRONMENT VARIABLES (Configure in Vercel Dashboard for Backend Service)
# ==============================================================================
# 1. PayPal Sandbox Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# 2. Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 3. Database Configuration
# For Vercel Serverless Demo Runtime (Temporary demo workaround):
DATABASE_URL=sqlite:////tmp/clearpayai.db
# IMPORTANT VERCEL RUNTIME NOTE:
# - Data stored in /tmp/clearpayai.db is EPHEMERAL and NOT permanently stored.
# - The database will reset on serverless instance restarts or scale-downs.
# - Separate concurrent serverless lambda instances do NOT share this database.
# - This is strictly for demo purposes and NOT suitable for production financial records.
#
# For Local Development (Default):
# DATABASE_URL=sqlite:///./clearpayai.db

# 4. Optional Frontend / CORS Overrides
# In Vercel multi-service deployment, VERCEL_URL is detected automatically.
# Set FRONTEND_URL if using a custom production domain (e.g., https://clearpayai.com).
# FRONTEND_URL=https://clearpayai.com
# CORS_ORIGINS=https://clearpayai.com

# 5. Optional Demo Mode (1 = enable simulated payments without real PayPal calls)
# DEMO_MODE=0

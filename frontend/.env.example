# ClearPay AI — Frontend Environment Variables (Vite)
# For local development:
VITE_API_BASE_URL=http://127.0.0.1:8000

# For Vercel Multi-Service Deployment:
# Leave VITE_API_BASE_URL unset/empty in Vercel environment variables.
# When left unset in production, frontend automatically uses same-origin relative URLs (/api/*),
# which root vercel.json routes to the clearpayai-backend service.
#
# Only set VITE_API_BASE_URL if hosting the backend on a separate domain:
# VITE_API_BASE_URL=https://api.mycustomdomain.com

